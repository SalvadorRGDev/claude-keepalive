#!/usr/bin/env bash
#
# claude-keepalive — anchors your Claude usage windows to fixed hours.
#
# Pings on a schedule spaced exactly WINDOW_HOURS apart, so each ping lands at
# the moment the previous window expires and the chain of resets never drifts.
#
# This does NOT grant extra quota. See README.md.

set -euo pipefail

VERSION="1.1.0"
PROGRAM="claude-keepalive"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"

CONFIG_DIR="$XDG_CONFIG_HOME/$PROGRAM"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="$XDG_STATE_HOME/$PROGRAM"
LOG_FILE="$STATE_DIR/log"
MANIFEST="$STATE_DIR/install-manifest"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/$PROGRAM.lock"

# ---- defaults (override these in $CONFIG_FILE) ------------------------------
CLAUDE_BIN=""                            # empty = auto-discover
CLAUDE_HOME="$HOME/.claude"
MODEL="claude-haiku-4-5-20251001"        # cheapest; the window is shared
PROMPT="ok"
HOURS="6,11,16,21"                       # ping hours, WINDOW_HOURS apart
WINDOW_HOURS=5                           # length of a Claude usage window

# Off by default, and that is deliberate. Skipping a ping because you happen to
# be active breaks the chain: the next window then starts whenever you send a
# message instead of on the hour, and every reset after it drifts. A window that
# is already half elapsed is not half an allowance — you can spend all of it in
# the time that remains and still get a fresh window at the next boundary. Set
# this to 1 only if you would rather save four trivial pings a day than keep
# your reset times predictable.
SKIP_IF_ACTIVE=0

MAX_BUDGET_USD="0.05"                    # hard spend ceiling per ping
PING_TIMEOUT=120                         # seconds before a ping is killed
LOG_MAX_LINES=500

# shellcheck source=/dev/null
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# ---- helpers ----------------------------------------------------------------

log() {
  mkdir -p "$STATE_DIR"
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*" >>"$LOG_FILE"
}

rotate_log() {
  [ -f "$LOG_FILE" ] || return 0
  local lines
  lines=$(wc -l <"$LOG_FILE")
  [ "$lines" -le "$LOG_MAX_LINES" ] && return 0
  tail -n "$LOG_MAX_LINES" "$LOG_FILE" >"$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

fmt_dur() { printf '%dh%02dm' $(($1 / 3600)) $((($1 % 3600) / 60)); }

# The backend library is only needed by `schedule`, so it is loaded on demand:
# a missing lib must never stop a ping from firing.
load_backend_lib() {
  local cand
  for cand in \
    "$SELF_DIR/../lib/$PROGRAM/backend.sh" \
    "$SELF_DIR/../lib/backend.sh"; do
    if [ -r "$cand" ]; then
      # shellcheck source=/dev/null
      . "$cand"
      return 0
    fi
  done
  return 1
}

manifest_field() {
  [ -r "$MANIFEST" ] || return 1
  awk -v k="$1" -F'\t' '$1==k{print $2}' "$MANIFEST"
}

# Locate the claude CLI. Never hardcode a path: installs vary by platform and by
# install method (distro package, npm, local installer, homebrew).
find_claude() {
  local c
  if [ -n "$CLAUDE_BIN" ]; then
    [ -x "$CLAUDE_BIN" ] && { printf '%s' "$CLAUDE_BIN"; return 0; }
    return 1
  fi
  for c in \
    "$(command -v claude 2>/dev/null || true)" \
    "$HOME/.claude/local/claude" \
    "$HOME/.local/bin/claude" \
    "/usr/local/bin/claude" \
    "/usr/bin/claude" \
    "/opt/homebrew/bin/claude"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# Epoch seconds of the most recent real Claude Code activity, from transcript
# mtimes. GNU find has -printf; BSD/macOS find does not.
newest_activity_epoch() {
  local dir="$CLAUDE_HOME/projects" newest=""
  [ -d "$dir" ] || return 1
  if find "$dir" -maxdepth 0 -printf '' >/dev/null 2>&1; then
    newest=$(find "$dir" -type f -name '*.jsonl' -printf '%T@\n' 2>/dev/null |
      sort -rn | head -1)
    newest="${newest%%.*}"
  else
    newest=$(find "$dir" -type f -name '*.jsonl' -exec stat -f '%m' {} + 2>/dev/null |
      sort -rn | head -1)
  fi
  [ -n "$newest" ] || return 1
  printf '%s' "$newest"
}

# Age in seconds of activity inside the current window, or failure if the last
# activity is older than a window.
window_age() {
  local last now age
  last=$(newest_activity_epoch) || return 1
  now=$(date +%s)
  age=$((now - last))
  [ "$age" -lt $((WINDOW_HOURS * 3600)) ] || return 1
  printf '%s' "$age"
}

# --restricted drops the code-running tools AND ignores user, project and local
# settings, so none of your hooks fire on a ping.
# --strict-mcp-config with no --mcp-config means: load no MCP servers at all.
build_cmd() {
  local bin=$1
  PING_CMD=(
    "$bin" -p "$PROMPT"
    --model "$MODEL"
    --restricted
    --strict-mcp-config
    --no-session-persistence
    --disable-slash-commands
    --max-budget-usd "$MAX_BUDGET_USD"
    --output-format text
  )
  if [ "$PING_TIMEOUT" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
    PING_CMD=(timeout "$PING_TIMEOUT" "${PING_CMD[@]}")
  fi
}

# ---- subcommands ------------------------------------------------------------

cmd_ping() {
  local dry=${1:-0} bin age
  bin=$(find_claude) || {
    log "ERROR: claude binary not found; set CLAUDE_BIN in $CONFIG_FILE"
    die "claude binary not found; set CLAUDE_BIN in $CONFIG_FILE"
  }

  if [ "$SKIP_IF_ACTIVE" -eq 1 ] && age=$(window_age); then
    local msg
    msg="skip: window already open (last activity $(fmt_dur "$age") ago)"
    if [ "$dry" -eq 1 ]; then
      printf '%s\n' "$msg"
      return 0
    fi
    log "$msg"
    rotate_log
    return 0
  fi

  build_cmd "$bin"

  if [ "$dry" -eq 1 ]; then
    printf 'would run:\n  '
    printf '%q ' "${PING_CMD[@]}"
    printf '\n'
    return 0
  fi

  # Never let two pings overlap: a hung ping must not stack up behind a timer.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    flock -n 9 || { log "skip: another ping is running"; return 0; }
  fi

  local out rc=0
  out=$("${PING_CMD[@]}" 2>&1) || rc=$?
  if [ "$rc" -eq 0 ]; then
    log "ping ok (model=$MODEL)"
  else
    log "ping FAILED rc=$rc: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)"
  fi
  rotate_log
  return "$rc"
}

# Change the ping hours in place, with no reinstall.
cmd_schedule() {
  local new="" backend

  while [ $# -gt 0 ]; do
    case "$1" in
      --hours | --hour) new="$2"; shift 2 ;;
      -*) die "unknown option for schedule: $1" ;;
      *) new="$1"; shift ;;
    esac
  done

  backend=$(manifest_field backend 2>/dev/null || true)
  [ -n "$backend" ] ||
    die "not installed — run ./install.sh first (nothing to reschedule)"

  load_backend_lib ||
    die "backend library not found next to $SELF_DIR — reinstall to get it"

  # No hours given: report the schedule rather than change it.
  if [ -z "$new" ]; then
    printf 'hours   : %s   (from %s)\n' "$HOURS" \
      "$([ -r "$CONFIG_FILE" ] && printf 'config' || printf 'defaults')"
    printf 'backend : %s\n\n' "$backend"
    backend_show "$backend"
    return 0
  fi

  new=$(hours_normalize "$new") || die "could not parse hours"
  hours_check_spacing "$new" "$WINDOW_HOURS" || true

  local bin
  bin=$(manifest_field file | grep "/bin/$PROGRAM\$" | head -1)
  [ -n "$bin" ] && [ -x "$bin" ] || bin="$SELF_DIR/$PROGRAM"

  printf 'rescheduling %s -> %s\n' "$HOURS" "$new"
  backend_apply "$backend" "$bin" "$new"

  # Persist it, so the next `schedule` and `status` agree with the scheduler.
  mkdir -p "$CONFIG_DIR"
  if [ -r "$CONFIG_FILE" ] && grep -qE '^[[:space:]]*HOURS=' "$CONFIG_FILE"; then
    sed -i.bak -E "s|^[[:space:]]*HOURS=.*|HOURS=\"$new\"|" "$CONFIG_FILE" &&
      rm -f "$CONFIG_FILE.bak"
  else
    printf 'HOURS="%s"\n' "$new" >>"$CONFIG_FILE"
  fi
  log "rescheduled to $new"
  printf '\ndone. %s status to confirm.\n' "$PROGRAM"
}

cmd_status() {
  local bin age backend
  printf '%s %s\n\n' "$PROGRAM" "$VERSION"

  if bin=$(find_claude); then
    printf 'claude binary : %s\n' "$bin"
  else
    printf 'claude binary : NOT FOUND\n'
  fi
  printf 'config        : %s%s\n' "$CONFIG_FILE" \
    "$([ -r "$CONFIG_FILE" ] || printf ' (missing, using defaults)')"
  printf 'model         : %s\n' "$MODEL"
  printf 'hours         : %s\n' "$HOURS"
  if [ "$SKIP_IF_ACTIVE" -eq 1 ]; then
    printf 'skip-if-active: yes (windows may drift — see README)\n'
  else
    printf 'skip-if-active: no (pings unconditionally, keeps windows anchored)\n'
  fi

  if age=$(window_age); then
    printf 'window        : OPEN (last activity %s ago, closes in %s)\n' \
      "$(fmt_dur "$age")" "$(fmt_dur $((WINDOW_HOURS * 3600 - age)))"
  else
    printf 'window        : closed (next ping will open one)\n'
  fi

  backend=$(manifest_field backend 2>/dev/null || true)
  printf 'backend       : %s\n' "${backend:-not installed}"

  if [ -n "$backend" ] && load_backend_lib; then
    printf '\n'
    backend_show "$backend"
  fi

  if [ -r "$LOG_FILE" ]; then
    printf '\nlast log lines:\n'
    tail -n 5 "$LOG_FILE" | sed 's/^/  /'
  fi
}

cmd_logs() { [ -r "$LOG_FILE" ] && tail -n "${1:-50}" "$LOG_FILE" || printf 'no log yet\n'; }

usage() {
  cat <<EOF
$PROGRAM $VERSION — anchor your Claude usage windows to fixed hours.

usage: $PROGRAM <command>

commands:
  ping                  Open a window now (what the timer calls)
  test                  Dry run: print the exact ping command, send nothing
  schedule              Show the active schedule
  schedule <hours>      Change the ping hours in place, no reinstall
                        e.g. $PROGRAM schedule 7,12,17,22
                             $PROGRAM schedule --hours "7,12,17,22"
  status                Binary, config, window state, schedule, recent log
  logs [n]              Last n log lines (default 50)
  version               Print version

Hours should sit exactly WINDOW_HOURS apart ($WINDOW_HOURS h) so each ping lands
when the previous window expires and your resets never drift.

config: $CONFIG_FILE
log:    $LOG_FILE
EOF
}

case "${1:-}" in
  ping) cmd_ping 0 ;;
  test) cmd_ping 1 ;;
  schedule) shift; cmd_schedule "$@" ;;
  status) cmd_status ;;
  logs) cmd_logs "${2:-50}" ;;
  version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
