#!/usr/bin/env bash
#
# claude-keepalive — you decide the hours at which a Claude usage window opens.
#
# A ping can only ever OPEN a window; it can never close one early or move a
# boundary. So the hours you schedule are guaranteed window starts, and that is
# what gives you control over when your resets land.
#
# This grants no extra quota. See README.md.

set -euo pipefail

VERSION="2.0.0"
PROGRAM="claude-keepalive"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"

CONFIG_DIR="$XDG_CONFIG_HOME/$PROGRAM"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_DIR="$XDG_STATE_HOME/$PROGRAM"
LOG_FILE="$STATE_DIR/log"
MANIFEST="$STATE_DIR/install-manifest"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/$PROGRAM.lock"

# ---- defaults (override these in $CONFIG_FILE) ------------------------------
CLAUDE_BIN=""                            # empty = auto-discover
CLAUDE_HOME="$HOME/.claude"
MODEL="claude-haiku-4-5-20251001"        # cheapest; the window is shared
PROMPT="ok"
HOURS="6,11,16,21"                       # hours at which to open a window
WINDOW_HOURS=5                           # length of a Claude usage window
MAX_BUDGET_USD="0.05"                    # hard spend ceiling per ping
PING_TIMEOUT=120                         # seconds before a ping is killed
LOG_MAX_LINES=500

# There is deliberately no option to skip a ping when you have been active
# recently. Such a check can only ask "was there activity in the last
# WINDOW_HOURS?", which is not the same question as "is a window open?" — and it
# answers wrongly at exactly the moment that matters. If a window opened at T and
# your last message was at A, then at T+WINDOW_HOURS, when the window expires and
# the ping is due, the age of that activity is under WINDOW_HOURS. The check says
# "skip" at every single boundary. Getting it right needs the window's start
# time, which local data does not reliably give us. So pings are unconditional.

# shellcheck source=/dev/null
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# ---- helpers ----------------------------------------------------------------

log() {
  mkdir -p "$STATE_DIR"
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*" >>"$LOG_FILE"
}

rotate_log() {
  [ -f "$LOG_FILE" ] || return 0
  local lines
  lines=$(wc -l <"$LOG_FILE")
  [ "$lines" -le "$LOG_MAX_LINES" ] && return 0
  tail -n "$LOG_MAX_LINES" "$LOG_FILE" >"$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
}

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

fmt_dur() { printf '%dh%02dm' $(($1 / 3600)) $((($1 % 3600) / 60)); }

# The backend library is only needed by `schedule` and `status`, so it is loaded
# on demand: a missing lib must never stop a ping from firing.
load_backend_lib() {
  local cand
  for cand in \
    "$SELF_DIR/../lib/$PROGRAM/backend.sh" \
    "$SELF_DIR/../lib/backend.sh"; do
    if [ -r "$cand" ]; then
      # shellcheck source=/dev/null
      . "$cand"
      return 0
    fi
  done
  return 1
}

manifest_field() {
  [ -r "$MANIFEST" ] || return 1
  awk -v k="$1" -F'\t' '$1==k{print $2}' "$MANIFEST"
}

# Locate the claude CLI. Never hardcode a path: installs vary by platform and by
# install method (distro package, npm, local installer, homebrew).
find_claude() {
  local c
  if [ -n "$CLAUDE_BIN" ]; then
    [ -x "$CLAUDE_BIN" ] && { printf '%s' "$CLAUDE_BIN"; return 0; }
    return 1
  fi
  for c in \
    "$(command -v claude 2>/dev/null || true)" \
    "$HOME/.claude/local/claude" \
    "$HOME/.local/bin/claude" \
    "/usr/local/bin/claude" \
    "/usr/bin/claude" \
    "/opt/homebrew/bin/claude"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# Epoch seconds of the most recent Claude Code activity, from transcript mtimes.
# GNU find has -printf; BSD/macOS find does not.
newest_activity_epoch() {
  local dir="$CLAUDE_HOME/projects" newest=""
  [ -d "$dir" ] || return 1
  if find "$dir" -maxdepth 0 -printf '' >/dev/null 2>&1; then
    newest=$(find "$dir" -type f -name '*.jsonl' -printf '%T@\n' 2>/dev/null |
      sort -rn | head -1)
    newest="${newest%%.*}"
  else
    newest=$(find "$dir" -type f -name '*.jsonl' -exec stat -f '%m' {} + 2>/dev/null |
      sort -rn | head -1)
  fi
  [ -n "$newest" ] || return 1
  printf '%s' "$newest"
}

# Seconds until the next scheduled hour, and which hour that is: "<hour> <secs>".
# Deliberately avoids `date -d`, which macOS does not have.
next_ping() {
  local hh mm ss now_s h arr d best_d="" best_h=""
  hh=$((10#$(date +%H)))
  mm=$((10#$(date +%M)))
  ss=$((10#$(date +%S)))
  now_s=$((hh * 3600 + mm * 60 + ss))
  IFS=',' read -ra arr <<<"$1"
  for h in "${arr[@]}"; do
    d=$(((10#$h) * 3600 - now_s))
    [ "$d" -le 0 ] && d=$((d + 86400))
    if [ -z "$best_d" ] || [ "$d" -lt "$best_d" ]; then
      best_d=$d
      best_h=$((10#$h))
    fi
  done
  [ -n "$best_d" ] || return 1
  printf '%s %s' "$best_h" "$best_d"
}

# --restricted drops the code-running tools AND ignores user, project and local
# settings, so none of your hooks fire on a ping.
# --strict-mcp-config with no --mcp-config means: load no MCP servers at all.
build_cmd() {
  local bin=$1
  PING_CMD=(
    "$bin" -p "$PROMPT"
    --model "$MODEL"
    --restricted
    --strict-mcp-config
    --no-session-persistence
    --disable-slash-commands
    --max-budget-usd "$MAX_BUDGET_USD"
    --output-format text
  )
  if [ "$PING_TIMEOUT" -gt 0 ] && command -v timeout >/dev/null 2>&1; then
    PING_CMD=(timeout "$PING_TIMEOUT" "${PING_CMD[@]}")
  fi
}

# ---- subcommands ------------------------------------------------------------

cmd_ping() {
  local dry=${1:-0} bin
  bin=$(find_claude) || {
    log "ERROR: claude binary not found; set CLAUDE_BIN in $CONFIG_FILE"
    die "claude binary not found; set CLAUDE_BIN in $CONFIG_FILE"
  }

  build_cmd "$bin"

  if [ "$dry" -eq 1 ]; then
    printf 'would run:\n  '
    printf '%q ' "${PING_CMD[@]}"
    printf '\n'
    return 0
  fi

  # Never let two pings overlap: a hung ping must not stack up behind a timer.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_FILE"
    flock -n 9 || { log "skip: another ping is running"; return 0; }
  fi

  local out rc=0
  out=$("${PING_CMD[@]}" 2>&1) || rc=$?
  if [ "$rc" -eq 0 ]; then
    log "ping ok (model=$MODEL)"
  else
    log "ping FAILED rc=$rc: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)"
  fi
  rotate_log
  return "$rc"
}

# Change the hours in place, with no reinstall.
cmd_schedule() {
  local new="" backend

  while [ $# -gt 0 ]; do
    case "$1" in
      --hours | --hour) new="$2"; shift 2 ;;
      -*) die "unknown option for schedule: $1" ;;
      *) new="$1"; shift ;;
    esac
  done

  backend=$(manifest_field backend 2>/dev/null || true)
  [ -n "$backend" ] ||
    die "not installed — run ./install.sh first (nothing to reschedule)"

  load_backend_lib ||
    die "backend library not found near $SELF_DIR — reinstall to get it"

  # No hours given: report the schedule rather than change it.
  if [ -z "$new" ]; then
    printf 'hours   : %s   (from %s)\n' "$HOURS" \
      "$([ -r "$CONFIG_FILE" ] && printf 'config' || printf 'defaults')"
    printf 'backend : %s\n\n' "$backend"
    backend_show "$backend"
    return 0
  fi

  new=$(hours_normalize "$new") || die "could not parse hours"
  hours_advise "$new" "$WINDOW_HOURS" || true

  local bin
  bin=$(manifest_field file | grep "/bin/$PROGRAM\$" | head -1)
  [ -n "$bin" ] && [ -x "$bin" ] || bin="$SELF_DIR/$PROGRAM"

  printf 'rescheduling %s -> %s\n' "$HOURS" "$new"
  backend_apply "$backend" "$bin" "$new"

  # Persist it, so the next `schedule` and `status` agree with the scheduler.
  mkdir -p "$CONFIG_DIR"
  if [ -r "$CONFIG_FILE" ] && grep -qE '^[[:space:]]*HOURS=' "$CONFIG_FILE"; then
    sed -i.bak -E "s|^[[:space:]]*HOURS=.*|HOURS=\"$new\"|" "$CONFIG_FILE" &&
      rm -f "$CONFIG_FILE.bak"
  else
    printf 'HOURS="%s"\n' "$new" >>"$CONFIG_FILE"
  fi
  log "rescheduled to $new"
  printf '\ndone. %s status to confirm.\n' "$PROGRAM"
}

cmd_status() {
  local bin backend last now age np nh nd
  printf '%s %s\n\n' "$PROGRAM" "$VERSION"

  if bin=$(find_claude); then
    printf 'claude binary : %s\n' "$bin"
  else
    printf 'claude binary : NOT FOUND\n'
  fi
  printf 'config        : %s%s\n' "$CONFIG_FILE" \
    "$([ -r "$CONFIG_FILE" ] || printf ' (missing, using defaults)')"
  printf 'model         : %s\n' "$MODEL"
  printf 'hours         : %s\n' "$HOURS"

  if np=$(next_ping "$HOURS"); then
    nh=${np% *}
    nd=${np#* }
    printf 'next ping     : %02d:00 (in %s)\n' "$nh" "$(fmt_dur "$nd")"
  fi

  # Report only what transcript mtimes can actually tell us. A message inside a
  # window proves a window is open; it does NOT reveal when that window started,
  # so its expiry is not knowable from here.
  if last=$(newest_activity_epoch); then
    now=$(date +%s)
    age=$((now - last))
    if [ "$age" -lt $((WINDOW_HOURS * 3600)) ]; then
      printf 'last activity : %s ago — a window is open\n' "$(fmt_dur "$age")"
    else
      printf 'last activity : %s ago — no window open\n' "$(fmt_dur "$age")"
    fi
  else
    printf 'last activity : none found\n'
  fi

  backend=$(manifest_field backend 2>/dev/null || true)
  printf 'backend       : %s\n' "${backend:-not installed}"

  if [ -n "$backend" ] && load_backend_lib; then
    printf '\n'
    backend_show "$backend"
  fi

  if [ -r "$LOG_FILE" ]; then
    printf '\nlast log lines:\n'
    tail -n 5 "$LOG_FILE" | sed 's/^/  /'
  fi

  # Removed in 2.0.0. Warn rather than ignore it silently, so anyone who set it
  # is not left wondering why nothing is being skipped.
  if [ -r "$CONFIG_FILE" ] && grep -qE '^[[:space:]]*SKIP_IF_ACTIVE=' "$CONFIG_FILE"; then
    printf '\nnote: SKIP_IF_ACTIVE was removed in 2.0.0 and no longer does anything.\n'
    printf '      Pings are always unconditional. Delete the line from your config.\n'
  fi
}

cmd_logs() { [ -r "$LOG_FILE" ] && tail -n "${1:-50}" "$LOG_FILE" || printf 'no log yet\n'; }

usage() {
  cat <<EOF
$PROGRAM $VERSION — you decide the hours at which a Claude usage window opens.

usage: $PROGRAM <command>

commands:
  ping                  Open a window now (what the timer calls)
  test                  Dry run: print the exact ping command, send nothing
  schedule              Show the active schedule
  schedule <hours>      Change the hours in place, no reinstall
                        e.g. $PROGRAM schedule 8,13
                             $PROGRAM schedule 8,13,18
                             $PROGRAM schedule --hours "6,11,16,21"
  status                Binary, config, next ping, window state, recent log
  logs [n]              Last n log lines (default 50)
  version               Print version

A ping only ever opens a window; it cannot close one early or move a boundary, so
it accomplishes something only if no window is open when it fires. Keep your hours
a whole number of windows apart ($WINDOW_HOURS h) and every one lands on a
boundary. See the "Choosing your hours" section of the README.

config: $CONFIG_FILE
log:    $LOG_FILE
EOF
}

case "${1:-}" in
  ping) cmd_ping 0 ;;
  test) cmd_ping 1 ;;
  schedule) shift; cmd_schedule "$@" ;;
  status) cmd_status ;;
  logs) cmd_logs "${2:-50}" ;;
  version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
