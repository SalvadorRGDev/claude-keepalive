[Unit]
Description=Claude Code usage-window keepalive ping
Documentation=https://github.com/SalvadorRGDev/claude-keepalive

[Service]
Type=oneshot
ExecStart=@BIN@ ping

# Deliberately silent: the script keeps its own rotated log. Sending nothing to
# journald means uninstall leaves no residue that would need `journalctl
# --vacuum` (which would nuke the whole user journal, not just ours).
StandardOutput=null
StandardError=null
