[Unit]
Description=Schedule claude-keepalive pings

[Timer]
OnCalendar=@ONCALENDAR@

# Do NOT catch up on missed runs: a boot-time catch-up would open a usage
# window at an arbitrary moment, which is the opposite of what this tool is for.
Persistent=false
RandomizedDelaySec=60
AccuracySec=1min

[Install]
WantedBy=timers.target
