# claude-keepalive configuration. Shell syntax.
# Installed to ~/.config/claude-keepalive/config

# Hours of the day at which to open a Claude usage window.
#
# A ping only ever OPENS a window — it cannot close one early or move a
# boundary, so it accomplishes something only when no window is open as it fires.
# Keep the hours a whole number of WINDOW_HOURS apart and each one lands exactly
# on a boundary, so none is ever wasted: "8,13" for two sessions over an ordinary
# day, "8,13,18" for two blocks with a break, "6,11,16,21" for continuous
# coverage. An hour that is not a multiple away (say the 18:00 in "6,18") only
# opens a window if you are genuinely idle when it fires.
# See "Choosing your hours" in the README.
#
# Change these with `claude-keepalive schedule 8,13` rather than by hand —
# editing this line alone does not update the systemd timer or crontab.
HOURS="6,11,16,21"

# ---- rarely changed --------------------------------------------------------

# Path to the claude CLI. Leave empty to auto-discover.
#CLAUDE_BIN=""

# Model used for the ping. The usage window is shared across models, so there is
# no reason to open one with anything but the cheapest.
#MODEL="claude-haiku-4-5-20251001"

# The prompt sent. Keep it trivial — you pay for every token.
#PROMPT="ok"

# Length of a Claude usage window, in hours.
#WINDOW_HOURS=5

# Hard spend ceiling per ping, passed to --max-budget-usd.
#MAX_BUDGET_USD="0.05"

# Kill the ping after this many seconds. 0 disables the timeout.
#PING_TIMEOUT=120

# Lines kept in ~/.local/state/claude-keepalive/log.
#LOG_MAX_LINES=500

# Note: SKIP_IF_ACTIVE existed in 1.x and was removed in 2.0.0. It could only
# ask "was there activity in the last WINDOW_HOURS?", which is not the same as
# "is a window open?" — and it answered wrongly at every boundary, which is the
# one moment a ping matters. Pings are now always unconditional.
