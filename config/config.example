# claude-keepalive configuration. Shell syntax.
# Installed to ~/.config/claude-keepalive/config

# ---- the two you will actually tune ----------------------------------------

# Hours of the day to ping. Keep them exactly WINDOW_HOURS apart so each ping
# lands when the previous window expires and your resets never drift.
# Change these with `claude-keepalive schedule 7,12,17,22` rather than by hand —
# editing this line alone does not update the systemd timer / crontab.
HOURS="6,11,16,21"

# 0 = ping unconditionally on schedule (default, keeps windows anchored).
# 1 = skip the ping when you were active recently.
#
# Leave this at 0 unless you know you want the trade. Skipping a ping breaks the
# chain: the next window then starts whenever you happen to send a message
# instead of on the hour, and every reset after it drifts. A half-elapsed window
# is not half an allowance — you can spend all of it in the time that remains
# and still get a fresh window at the next boundary.
SKIP_IF_ACTIVE=0

# ---- rarely changed --------------------------------------------------------

# Path to the claude CLI. Leave empty to auto-discover.
#CLAUDE_BIN=""

# Model used for the ping. The usage window is shared across models, so there is
# no reason to open one with anything but the cheapest.
#MODEL="claude-haiku-4-5-20251001"

# The prompt sent. Keep it trivial — you pay for every token.
#PROMPT="ok"

# Length of a Claude usage window, in hours.
#WINDOW_HOURS=5

# Hard spend ceiling per ping, passed to --max-budget-usd.
#MAX_BUDGET_USD="0.05"

# Kill the ping after this many seconds. 0 disables the timeout.
#PING_TIMEOUT=120

# Lines kept in ~/.local/state/claude-keepalive/log.
#LOG_MAX_LINES=500
